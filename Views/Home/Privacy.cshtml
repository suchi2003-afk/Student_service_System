@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="page-inner">
<div class="container">
<div class="sec-title">
    <h2>Privacy <span>Policy</span></h2>
    <p>Your data is protected — IUBAT Campus Services handles all requests securely and privately.</p>
</div>
<div class="detail-card">
    <div class="detail-body">
        <h4 style="color:var(--primary); text-transform:uppercase; font-size:16px; letter-spacing:0.04em;"><i class="fa fa-shield" style="color:var(--accent);"></i> Privacy Commitment</h4>
        <p>Use this page to detail your site's privacy policy. All student data is stored securely and accessible only to you and authorized staff members. Requests are processed in compliance with IUBAT academic regulations.</p>
        <p style="margin-bottom:0;">For questions about data handling, contact <a href="mailto:info@iubat.edu">info@iubat.edu</a>.</p>
    </div>
</div>
</div>
</div>
