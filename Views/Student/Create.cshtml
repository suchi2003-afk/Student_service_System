@model WebApplication1.Models.ViewModels.ServiceRequestViewModel
@{
    ViewData["Title"] = "Submit Request";
}

<div class="page-inner">
<div class="container">
<div class="sec-title">
    <h2>Submit a <span>Service Request</span></h2>
    <p>Select a request type and describe your need — staff will review within 48 hours.</p>
</div>
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="detail-card">
            <div class="detail-header">
                <h4 class="mb-0 fw-bold">Submit a Service Request</h4>
            </div>
            <div class="detail-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius:8px;"></div>

                    <div class="mb-4">
                        <label asp-for="RequestType" class="form-label"></label>
                        <select asp-for="RequestType" class="form-select"
                                asp-items="@(new SelectList(Enum.GetValues(typeof(WebApplication1.Models.RequestType))))">
                            <option value="">-- Select a request type --</option>
                        </select>
                        <span asp-validation-for="RequestType" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                                  placeholder="Describe your request in detail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary-custom flex-fill"><i class="fa fa-paper-plane"></i> Submit Request</button>
                        <a asp-action="MyRequests" class="btn btn-outline-secondary" style="border-radius:4px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
